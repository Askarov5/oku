# PostgreSQL
DATABASE_URL=postgresql://oku:oku@localhost:5432/oku

# Local filesystem object storage (default for Phase 1 local dev)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.r2-local

# Cloudflare R2 / MinIO (used when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=oku-media
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_BASE_URL=http://localhost:9000/oku-media
R2_FORCE_PATH_STYLE=true

# Page extraction via LiteLLM (leave empty / MOCK_LLM=true for fixture ingestion).
# The same keys belong in apps/web/.env.local so the admin catalog can list them.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Admin gate (Phase 1 — real RBAC in Phase 5)
ADMIN_TOKEN=dev-admin-token

# Worker
INGEST_PAGE_CONCURRENCY=2
WORKER_POLL_INTERVAL_SEC=2
MOCK_LLM=true
